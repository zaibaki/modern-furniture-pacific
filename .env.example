# Supabase backend (zaibaki/modern-furniture-pacific-backend).
# The live project does not exist yet — create it first (see the backend
# README, "Connecting the frontend"), then fill these in. Until both vars
# are set, the site keeps reading the baked-in src/data/products.json.
# The anon key is publishable by design (RLS allows public reads only),
# but it still goes in Vercel env vars / a local .env — never in git.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
